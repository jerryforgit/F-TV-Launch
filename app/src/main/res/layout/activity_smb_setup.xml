<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_smb"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/setup_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="80dp"
        android:paddingTop="40dp"
        android:paddingRight="80dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:id="@+id/setup_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/smb_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="局域网位置（SMB）"
                android:textColor="#FF4D4D4D"
                android:textSize="44dp" />

            <TextView
                android:id="@+id/smb_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:text="方向键选择，OK 编辑；账号密码不需要就留空"
                android:textColor="#FF8A8A8A"
                android:textSize="24dp" />

            <TextView
                android:id="@+id/row_scan"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/cell_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingLeft="32dp"
                android:text="扫描局域网（自动找 SMB 主机）"
                android:textColor="@color/textColor"
                android:textSize="32dp" />

            <TextView
                android:id="@+id/row_url"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/cell_bg"
                android:clickable="true"
                android:focusable="true"
                android:ellipsize="middle"
                android:gravity="center_vertical"
                android:paddingLeft="32dp"
                android:singleLine="true"
                android:text="地址：未填写"
                android:textColor="@color/textColor"
                android:textSize="32dp" />

            <TextView
                android:id="@+id/row_user"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/cell_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingLeft="32dp"
                android:text="账号：不填（匿名 / guest）"
                android:textColor="@color/textColor"
                android:textSize="32dp" />

            <TextView
                android:id="@+id/row_pass"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/cell_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingLeft="32dp"
                android:text="密码：不填"
                android:textColor="@color/textColor"
                android:textSize="32dp" />

            <TextView
                android:id="@+id/row_connect"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:background="@drawable/cell_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingLeft="32dp"
                android:text="连接"
                android:textColor="@color/textColor"
                android:textSize="32dp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="#FF8A8A8A"
                android:textSize="24dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/list_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="80dp"
        android:paddingTop="40dp"
        android:paddingRight="80dp"
        android:paddingBottom="40dp"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/list_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/list_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF4D4D4D"
                android:textSize="40dp" />

            <TextView
                android:id="@+id/list_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:textColor="#FF8A8A8A"
                android:textSize="24dp" />

            <LinearLayout
                android:id="@+id/list_rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:id="@+id/edit_box"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2D3DCEA"
        android:orientation="vertical"
        android:paddingLeft="80dp"
        android:paddingTop="50dp"
        android:paddingRight="80dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/edit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF4D4D4D"
            android:textSize="40dp" />

        <EditText
            android:id="@+id/edit_input"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/cell_bg"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingLeft="28dp"
            android:singleLine="true"
            android:textColor="@color/textColor"
            android:textSize="30dp" />

        <LinearLayout
            android:id="@+id/edit_keys"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />
    </LinearLayout>
</FrameLayout>
